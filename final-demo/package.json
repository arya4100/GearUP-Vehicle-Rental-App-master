{
  "name": "final-demo",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "firebase": "^12.6.0",
    "framer-motion": "^12.23.25",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.10.0",
    "react-scripts": "5.0.1",
    "uuid": "^13.0.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "eslint-plugin-security": "^2.1.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "security:audit":      "npm audit --omit=dev --audit-level=critical",
    "security:audit:full": "npm audit --json > security-audit-report.json && echo Report saved to security-audit-report.json",
    "security:check":      "npm run security:audit && echo [PASS] No critical vulnerabilities found in production deps.",
    "security:all":        "npm run security:check && npm run security:lint",
    "security:lint":       "eslint src --ext .js,.jsx --rule \"no-eval:error\" --rule \"no-implied-eval:error\" --rule \"no-new-func:error\" --max-warnings 0 --format codeframe"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:security/recommended"
    ],
    "plugins": [
      "security"
    ],
    "rules": {
      "no-eval": "error",
      "no-implied-eval": "error",
      "no-new-func": "error",
      "security/detect-object-injection": "warn",
      "security/detect-non-literal-regexp": "warn",
      "security/detect-unsafe-regex": "error",
      "security/detect-possible-timing-attacks": "warn"
    }
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router$": "<rootDir>/node_modules/react-router/dist/index.js"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(react-router-dom|react-router|@remix-run)/)"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
